{
  "name": "matchcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "MATCHCUT_DEV=1 tsx watch --ignore './data/**' --ignore './output/**' --ignore './public/**' server/index.ts",
    "start": "tsx server/index.ts",
    "service:start": "tsx scripts/mac-service.ts start",
    "service:stop": "tsx scripts/mac-service.ts stop",
    "service:status": "tsx scripts/mac-service.ts status",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "studio": "remotion studio src/video/index.tsx",
    "design:study": "tsx scripts/design-study.ts",
    "design:check": "tsx scripts/design-study-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "tsx scripts/fixture.ts",
    "format": "prettier --write src server scripts tests vite.config.ts tsconfig.json package.json README.md",
    "test:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@akiver/cs-demo-analyzer": "^1.11.0",
    "@fontsource/orbitron": "^5.2.8",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.534",
    "sharp": "^0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
